<div class="my-3">
  <a href="/script/list" class="btn btn-outline-secondary">← Listado de scripts</a>
</div>

<div class="container mt-4">
  <h1 class="mb-4">Editor de Script: <span class="text-primary">{{script}}</span></h1>

  <form>
    <div class="mb-4">
      <label for="description" class="form-label">Descripción</label>
      <input type="text" class="form-control" id="description" placeholder="Descripción del script">
    </div>
  </form>

  <div class="mb-4">
    <label class="form-label">Código</label>
    <div id="container" style="height: 600px; border: 1px solid #ced4da; border-radius: .25rem;"></div>
  </div>

  <div class="d-flex justify-content-end">
    <button id="saveButton" type="button" class="btn btn-success" disabled><i class="fas fa-save"></i> Guardar</button>
  </div>
</div>

<!-- OR ANY OTHER AMD LOADER HERE INSTEAD OF loader.js -->
<script src="/public/js/monaco-editor/min/vs/loader.js"></script>
<script>
	require.config({ paths: { vs: '/public/js/monaco-editor/min/vs' } });
	require(['vs/editor/editor.main'], function () {
		var editor = monaco.editor.create(document.getElementById('container'), {
			language: 'javascript'
		});
		var template = null;
		$.get('/script/item/{{script}}',
			function( data ) {
				script = data; 
				editor.setValue(data.content);
				$('#description').val(data.description);
				editor.getModel().onDidChangeContent((event) => {
					$('#saveButton').prop('disabled', false)
				});
			});
		$("#saveButton").click(function(){
				script.description = $('#description').val()
				script.content = editor.getValue()
				$.ajax({
					url: '/script',
					type: 'PUT',
					data: script,
					success: function(data) {
						alert('Script grabado correctamente');
						$('#saveButton').prop('disabled', true)
					}
				});
			})
		$('#description').change(function(){
			$('#saveButton').prop('disabled', false)
		});
	});
</script>