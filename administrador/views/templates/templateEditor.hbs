<div class="my-3">
  <a href="/template/list" class="btn btn-outline-secondary">← Listado de plantillas</a>
</div>

<div class="container mt-4">
  <h1 class="mb-4">Editor de Plantilla: <span class="text-primary">{{template}}</span></h1>

  <form>
    <div class="mb-4">
      <label for="description" class="form-label">Descripción</label>
      <input type="text" class="form-control" id="description" placeholder="Descripción de la plantilla">
    </div>
  </form>

  <div class="row">
    <div class="col-md-8">
      <label class="form-label">Código</label>
      <div id="container" style="height: 600px; border: 1px solid #ced4da; border-radius: .25rem;"></div>
    </div>
    <div class="col-md-4">
      <label class="form-label">Vista previa</label>
      <div id="view" style="width: 100%; height: 600px; border: 1px solid #ced4da; border-radius: .25rem; background-color: white;"></div>
    </div>
	      <div class="d-flex justify-content-end mt-3">
        <button id="saveButton" type="button" class="btn btn-success" disabled><i class="fas fa-save"></i> Guardar</button>
      </div>
  </div>
</div>



<!-- OR ANY OTHER AMD LOADER HERE INSTEAD OF loader.js -->
<script src="/public/js/monaco-editor/min/vs/loader.js"></script>
<script>
	require.config({ paths: { vs: '/public/js/monaco-editor/min/vs' } });
	require(['vs/editor/editor.main'], function () {
		var editor = monaco.editor.create(document.getElementById('container'), {
			language: 'html'
		});
		var template = null;
		$.get('/template/item/{{template}}',
			function( data ) {
				template = data; 

				editor.setValue(data.content);
				$('#description').val(data.description);
				$('#view').html(data.content);

				editor.getModel().onDidChangeContent((event) => {
					$('#view').html(editor.getValue());
					$('#saveButton').prop('disabled', false)
				});
			});
		$("#saveButton").click(function(){

				template.description = $('#description').val()
				template.content = editor.getValue()

				$.ajax({
					url: '/template',
					type: 'PUT',
					data: template,
					success: function(data) {
						alert('Plantilla grabada correctamente');
						$('#saveButton').prop('disabled', true)
					}
				});
			});

		$('#description').change(function(){
			$('#saveButton').prop('disabled', false)
		});
	});
</script>